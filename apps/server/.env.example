# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# SQLite for local development. To use PostgreSQL again:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/liquilink?schema=public"
DATABASE_URL="file:./dev.db"

# --- Auth / JWT ---
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# --- Cookies ---
COOKIE_SECURE=false

# --- CORS ---
WEB_ORIGIN="http://localhost:3000"

# --- Mailer ---
MAILER_HOST="smtp.example.com"
MAILER_PORT=587
MAILER_USER=""
MAILER_PASS=""
MAILER_FROM="LiquiLink <noreply@liquilink.in>"
MAILER_SECURE=false

# --- Frontend URLs (used in emails/redirects) ---
APP_URL="http://localhost:3000"

# --- Branding ---
BRAND_NAME="LiquiLink"
